/* app.wxss - 全局样式 */
page {
  background-color: #FFF5F9;
  color: #374151;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.container {
  padding: 0 24rpx;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.12);
  margin-bottom: 20rpx;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B9D, #C084FC);
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-danger {
  background: #F87171;
  color: #FFFFFF;
  border: none;
  border-radius: 24rpx;
  font-size: 28rpx;
  padding: 20rpx;
  text-align: center;
}

.btn-danger::after {
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9CA3AF;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  line-height: 1.8;
}

/* 通用 section title */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  padding: 20rpx 0 16rpx;
  display: flex;
  align-items: center;
}

/* 分数颜色 */
.score-up {
  color: #34D399;
}

.score-down {
  color: #F87171;
}

.score-primary {
  color: #FF6B9D;
}
